# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication
JWT_SECRET="skillswap_super_secret_jwt_key_2026_mca_project"
JWT_EXPIRES_IN="7d"

# Database Configuration (MySQL)
# When configured with a running MySQL server, SkillSwap Global connects directly via mysql2.
# If MySQL is not detected or offline, the app seamlessly initializes its built-in relational SQL database with identical tables and seed data.
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="skillswap_db"

# GEMINI_API_KEY: Optional / injected at runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
